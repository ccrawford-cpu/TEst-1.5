# Neon Postgres connection string (pooled), from https://console.neon.tech
DATABASE_URL=

# Resend API key, from https://resend.com/api-keys
RESEND_API_KEY=

# Address Resend sends FROM. Must be a verified domain/sender in Resend,
# or use the sandbox address "onboarding@resend.dev" for testing.
CONTACT_FROM_EMAIL=

# Address that receives the "someone submitted the form" notification
CONTACT_TO_EMAIL=
